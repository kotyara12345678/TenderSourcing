# ============================================================================
# TenderSourcing — example environment file.
# Copy to .env and fill in real values. NEVER commit real secrets.
# All variables are validated centrally at service startup (services/rust/crates/common).
# ============================================================================

# ---------- Application ----------
APP_ENV=development                 # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8080
APP_SECRET=change-me-internal-secret   # internal signing secret (non-session)
PUBLIC_API_ORIGIN=http://localhost:8080   # origin used in links inside reports
CORS_ORIGINS=http://localhost:5173        # comma-separated allowlist

# ---------- PostgreSQL ----------
# Password used by the bundled postgres container (deploy/docker-compose.yml).
# Must match the password inside DATABASE_URL.
POSTGRES_PASSWORD=tender
DATABASE_URL=postgres://tendersourcing:tender@postgres:5432/tendersourcing
DATABASE_MAX_CONNECTIONS=10

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20

# ---------- Auth (single operator; no public registration) ----------
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-strong-password
AUTH_SECRET=change-me-auth-secret
AUTH_SESSION_TTL=86400             # seconds
AUTH_COOKIE_SECURE=false           # true in production (HTTPS only)

# ---------- Keenable search provider (https://keenable.ai) ----------
KEENABLE_API_KEY=
KEENABLE_BASE_URL=https://api.keenable.ai
KEENABLE_SEARCH_LIMIT=500          # max search calls per tender run
KEENABLE_FETCH_LIMIT=300           # max fetch calls per tender run
KEENABLE_MAX_RPS=8                 # org limit is 10 rps; keep headroom
KEENABLE_SEARCH_MODE=pro           # pro | realtime

# ---------- Fetch engine ----------
FETCH_BACKEND=keenable             # keenable | direct  (direct = built-in SSRF-guarded crawler)
FETCH_MAX_CHARS=50000
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_REDIRECTS=5
FETCH_MAX_PER_COMPONENT=8          # pages fetched per tender position

# ---------- LLM (OpenAI-compatible endpoint) ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini             # cheap first-pass extraction
LLM_FALLBACK_MODEL=gpt-4.1         # stronger model for ambiguous cases
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096

# ---------- OCR ----------
OCR_PROVIDER=none                  # none | paddle | api
OCR_API_KEY=
OCR_BASE_URL=

# ---------- File storage ----------
STORAGE_PROVIDER=local             # local | s3
STORAGE_PATH=/data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- Business limits ----------
MAX_FILE_SIZE=26214400             # 25 MiB per uploaded file
MAX_TENDER_COMPONENTS=500
MAX_SEARCH_QUERIES=12              # queries per tender position
MAX_FETCH_REQUESTS=300
MAX_LLM_TOKENS_PER_TENDER=2000000
MAX_TENDER_DURATION=7200           # seconds, hard deadline per run

# ---------- Concurrency ----------
WORKER_CONCURRENCY=4
SEARCH_CONCURRENCY=4
AI_CONCURRENCY=2
DOCUMENT_CONCURRENCY=2

# ---------- Observability ----------
LOG_LEVEL=info                     # error | warn | info | debug | trace
OTEL_EXPORTER_OTLP_ENDPOINT=       # empty = tracing exporter disabled
SENTRY_DSN=                        # empty = Sentry disabled

# ---------- Service mesh (internal gRPC + worker health) ----------
MATCHING_GRPC_URL=http://matching:50051   # orchestrator -> matching service
SEARCH_GRPC_URL=http://search:50052       # orchestrator -> search service
HTTP_PORT=8090                            # health endpoint port (workers)

# ---------- Frontend build-time vars (Vite) ----------
VITE_API_BASE_URL=/api/v1
