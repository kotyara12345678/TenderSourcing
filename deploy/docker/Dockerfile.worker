# Build any Python worker: pass SERVICE=document_worker | ai_worker | report_worker.
# Build context is the repository root (protos and scripts are needed).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/services/python

# fonts-dejavu-core is required for Cyrillic PDF reports (ReportLab).
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY services/python/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY proto ./proto
COPY scripts/gen-proto-python.sh ./scripts/gen-proto-python.sh
COPY services/python ./services/python
RUN bash scripts/gen-proto-python.sh

RUN useradd --system --uid 10002 --create-home --home /home/worker worker \
    && mkdir -p /data/storage \
    && chown -R worker:worker /data
USER worker

ARG SERVICE=document_worker
ENV SERVICE=${SERVICE}

WORKDIR /app/services/python
CMD ["sh", "-c", "python -m ${SERVICE}.main"]
